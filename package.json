{
  "name": "@cvs0/forward-rpc",
  "version": "0.1.0",
  "description": "Declarative, schema-driven HTTP API integration framework with type-safe clients.",
  "sideEffects": false,
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "import": "./dist/zod.js",
      "require": "./dist/zod.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run clean && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "rpc",
    "http",
    "integration",
    "typescript",
    "schema"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cvs0/ForwardRPC.git"
  },
  "bugs": {
    "url": "https://github.com/cvs0/ForwardRPC/issues"
  },
  "homepage": "https://github.com/cvs0/ForwardRPC#readme",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "zod": "^3.25.0 || ^4.0.0"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.18",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "zod": "^3.25.28"
  }
}
